# Loaded by `next build` / `next start` (production only; `next dev` ignores it).
# Public origin of the site: canonical URLs, Open Graph, robots.txt, sitemap.xml.
# https:// also turns on HSTS and upgrade-insecure-requests, so the server must
# serve the site over HTTPS. Not a secret; an environment variable of the same
# name on the server takes precedence over this file.
NEXT_PUBLIC_SITE_URL=https://helvetique.ba
