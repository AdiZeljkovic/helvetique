# Public origin of the deployed site. Used for canonical URLs, Open Graph,
# robots.txt and sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional. HTTPS endpoint that accepts a JSON POST from the contact form
# (see src/lib/contact.ts for the payload shape). Leave unset until a mail
# backend exists; the form then tells visitors to call the office instead.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://www.example.com/api/inquiry
